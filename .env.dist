APP_NAME=nusacall
PORT=4100
NODE_ENV=development
APP_URL=http://localhost:4100

DB_HOST=localhost
DB_PORT=3306
DB_USER=nusacall
DB_PASS=
DB_NAME=nusacall
DB_SYNC=true

JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=28800

META_CONFIG_PATH=

NUSAWA_BASE_URL=http://localhost:9001
NUSAWA_API_KEY=
NUSAWA_LOOKUP_TIMEOUT_MS=2000

CALL_ANSWER_TIMEOUT=20
WEBHOOK_STALE_SECONDS=120
CALL_RECONCILE_AFTER_MINUTES=30

MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=nusacall-recordings

CALL_RECORDING_ENABLED=false
ASTERISK_RECORDING_DIR=/var/spool/asterisk/recording

CALL_PERMISSION_CACHE_TTL=60

ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_APP=nusacall-sip
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_SIP_HOSTNAME=
ASTERISK_SIP_PORT=5061
ASTERISK_AGENT_CONFIG_PATH=/etc/asterisk/pjsip_agents.conf

# Dikirim ke browser agent supaya softphone-nya bisa mendaftar ke Asterisk.
AGENT_SIP_WS_URL=
AGENT_SIP_DOMAIN=
