# ── Aplikasi ────────────────────────────────────────────────────────
APP_NAME=nusacall
PORT=4100
NODE_ENV=development
APP_URL=http://localhost:4100

# ── Database ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=nusacall
DB_PASS=
DB_NAME=nusacall
DB_SYNC=true

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=28800

# ── Meta WhatsApp Business Calling API ─────────────────────────────
# Kredensialnya berada di configs/meta.json, bukan di sini. Salin
# configs/meta.example.json lalu daftarkan tiap aplikasi beserta business
# account-nya. Nomor telepon tetap pada tabel accounts dan dihubungkan
# lewat business_account_id. Isi variabel ini hanya bila berkasnya
# diletakkan di luar lokasi bawaan.
META_CONFIG_PATH=

# ── NusaWA (nusawachannel-backend) ─────────────────────────────────
NUSAWA_BASE_URL=http://localhost:9001
NUSAWA_API_KEY=
NUSAWA_LOOKUP_TIMEOUT_MS=2000

# ── Siklus hidup panggilan ──────────────────────────────────────────
CALL_ANSWER_TIMEOUT=20
WEBHOOK_STALE_SECONDS=120
CALL_RECONCILE_AFTER_MINUTES=30

# ── Media plane (WebRTC) ────────────────────────────────────────────
ICE_GATHERING_TIMEOUT_MS=3000
MEDIA_SESSION_MAX_MINUTES=240
MEDIA_PUBLIC_IP=
MEDIA_UDP_PORT_MIN=40000
MEDIA_UDP_PORT_MAX=40100

# ── MinIO (Fase 2) ──────────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=nusacall-recordings

# ── Rekaman panggilan (direkam oleh backend saat menjembatani media) ──
FFMPEG_PATH=ffmpeg
CALL_RECORDING_ENABLED=false

# ── Panggilan keluar (Fase 3) ─────────────────────────────────────────
# VOICE_CALL_REQUEST-category template — create it in Meta Business
# Manager first (no Meta approval needed for this category, but it's a
# Business Manager UI action, not something this app can do).
CALL_PERMISSION_CACHE_TTL=60

# ── Asterisk / SIP (menggantikan Meta WebRTC calling) ─────────────────
# ARI dan backend idealnya co-located (localhost) di production. externalMedia
# port range harus terpisah dari MEDIA_UDP_PORT_MIN/MAX di atas (dipakai leg
# agent WebRTC, bukan leg SIP).
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_APP=nusacall-sip
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_SIP_HOSTNAME=
ASTERISK_SIP_PORT=5061
ASTERISK_EXTERNAL_MEDIA_HOST=127.0.0.1
ASTERISK_EXTERNAL_MEDIA_PORT_MIN=41000
ASTERISK_EXTERNAL_MEDIA_PORT_MAX=41100
