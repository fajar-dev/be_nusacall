# ── Aplikasi ────────────────────────────────────────────────────────
APP_NAME=nusacall
PORT=4100
NODE_ENV=development
APP_URL=http://localhost:4100

# ── Database ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=nusacall
DB_PASS=
DB_NAME=nusacall
DB_SYNC=true

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=28800
API_KEY=dev-api-key-change-me

# ── Meta WhatsApp Business Calling API ─────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# ── NusaWA (nusawachannel-backend) ─────────────────────────────────
NUSAWA_BASE_URL=http://localhost:9001
NUSAWA_API_KEY=
NUSAWA_WEB_URL=
NUSAWA_LOOKUP_TIMEOUT_MS=2000
NUSAWA_ME_CACHE_TTL=60
NUSAWA_CONTACT_CACHE_TTL=30

# ── Siklus hidup panggilan ──────────────────────────────────────────
CALL_ANSWER_TIMEOUT=20
WEBHOOK_STALE_SECONDS=120
CALL_RECONCILE_AFTER_MINUTES=30

# ── Media plane (WebRTC) ────────────────────────────────────────────
ICE_GATHERING_TIMEOUT_MS=3000
MEDIA_SESSION_MAX_MINUTES=240
MEDIA_PUBLIC_IP=
MEDIA_UDP_PORT_MIN=40000
MEDIA_UDP_PORT_MAX=40100

# ── MinIO (Fase 2) ──────────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=nusacall-recordings

# ── Rekaman & transkrip panggilan (Fase 2) ───────────────────────────
CALL_RECORDING_ENABLED=false
CALL_TRANSCRIPTION_ENABLED=false
CALL_RECORDING_PURPOSE=quality assurance
CALL_RECORDING_ANNOUNCEMENT_LANGUAGE=en_US
RECORDING_DOWNLOAD_INTERVAL_MINUTES=5
